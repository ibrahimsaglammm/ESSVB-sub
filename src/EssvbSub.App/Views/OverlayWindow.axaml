<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EssvbSub.App.Views.OverlayWindow"
        Title="ESSVB-sub Overlay"
        Width="1120"
        Height="240"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        CanResize="False">
  <Grid VerticalAlignment="Bottom" Margin="20,8">
    <StackPanel x:Name="LinesHost" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
  </Grid>
</Window>
