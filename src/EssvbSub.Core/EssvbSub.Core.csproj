<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright (c) 2026 ESSVB. All Rights Reserved. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EssvbSub.Core</AssemblyName>
    <RootNamespace>EssvbSub.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EssvbSub.Tests" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\essvb_fast\bin\essvb_fast.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\essvb_fast\bin\essvb_fast.dll" Link="essvb_fast.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\essvb_fast\bin\libessvb_fast.so')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\essvb_fast\bin\libessvb_fast.so" Link="libessvb_fast.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
