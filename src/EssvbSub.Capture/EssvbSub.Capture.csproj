<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright (c) 2026 ESSVB. All Rights Reserved. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EssvbSub.Capture</AssemblyName>
    <RootNamespace>EssvbSub.Capture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TizenSdb.Core" Version="1.1.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TvInstall\Ca\*.pem" LogicalName="EssvbCa.%(Filename).pem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EssvbSub.Core\EssvbSub.Core.csproj" />
    <ProjectReference Include="..\EssvbSub.Translation\EssvbSub.Translation.csproj" />
  </ItemGroup>

  <!-- Copy native Remote Play library if compiled locally (Windows essvb_rp.dll or CachyOS libessvb_rp.so) -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\bin\essvb_rp.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\bin\essvb_rp.dll" Link="essvb_rp.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\bin\libessvb_rp.so')">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\bin\libessvb_rp.so" Link="libessvb_rp.so"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EssvbSub.Tests" />
  </ItemGroup>

</Project>
